{
  "services": {
    "frontend-ui": {
      "root": "frontend/",
      "bindings": [
        {
          "type": "service",
          "service": "backend-api",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    },
    "backend-api": {
      "root": "backend/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "frontend-ui" } }]
}
