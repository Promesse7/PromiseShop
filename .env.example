DJANGO_SECRET_KEY=change-me-in-.env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=promiseshop
POSTGRES_USER=promiseshop
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Optional: override host-side Docker Compose port bindings (defaults shown).
# Only needed when running multiple checkouts (e.g. parallel git worktrees)
# against docker-compose.yml at the same time, to avoid host port collisions.
# HOST_POSTGRES_PORT=5432
# HOST_REDIS_PORT=6379
# HOST_WEB_PORT=8000
