DJANGO_SECRET_KEY=change-me-in-.env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=promiseshop
POSTGRES_USER=promiseshop
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Set by `neon checkout`/`neon link` (see .neon) to point at your linked Neon
# branch — takes priority over the POSTGRES_* vars above, including for local
# dev. Leave unset only if you want docker-compose's local Postgres instead.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
#
# In production also set:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=<your-backend-service>.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<your-backend-service>.vercel.app
# REDIS_URL=<managed Redis URL, e.g. Upstash rediss://...>

# Optional: override host-side Docker Compose port bindings (defaults shown).
# Only needed when running multiple checkouts (e.g. parallel git worktrees)
# against docker-compose.yml at the same time, to avoid host port collisions.
# HOST_POSTGRES_PORT=5432
# HOST_REDIS_PORT=6379
# HOST_WEB_PORT=8000
